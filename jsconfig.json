{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
  },
  "include": ["server/src/**/*", "web/src/**/*", "mobile/src/**/*", "packages/core/**/*"],
  "exclude": ["node_modules", "**/dist", "mobile/android", "mobile/ios"]
}
