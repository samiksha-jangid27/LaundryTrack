{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
  },
  "include": ["backend/src/**/*", "backend/shared/**/*", "frontend/src/**/*"],
  "exclude": ["node_modules", "**/dist", "frontend/android", "frontend/ios", "backend/generated"]
}
