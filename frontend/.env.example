EXPO_PUBLIC_API_URL=https://laundrytrack-1.onrender.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS reversed client ID from Google Cloud; not needed for Android.
GOOGLE_IOS_URL_SCHEME=
# Public project UUID from Expo/EAS (required for remote push).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Local path or EAS file environment variable containing Android google-services.json.
GOOGLE_SERVICES_JSON=
# Only public configuration belongs in EXPO_PUBLIC_* variables.
