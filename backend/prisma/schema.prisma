generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  staff
  owner
}

enum Stage {
  booked
  collected
  received
  cleaning
  quality_check
  packing
  ready
  out_for_delivery
  delivered
  cancelled
}

enum IssueStatus {
  open
  resolved
}

model User {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  phone            String
  role             Role             @default(customer)
  password_hash    String
  created_at       DateTime         @default(now())
  sessions         Session[]
  orders           Order[]          @relation("CustomerOrders")
  assignments      Order[]          @relation("AssignedOrders")
  events           Event[]
  actions          Action[]
  issues           Issue[]
  booking_requests BookingRequest[]

  @@map("users")
}

model Session {
  token_hash String   @id
  user_id    String
  expires_at DateTime
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("sessions")
}

model Service {
  id          String      @id
  name        String
  description String
  unit        String
  price       Int
  hours       Int
  active      Boolean     @default(true)
  items       OrderItem[]

  @@map("services")
}

model Order {
  id                 String           @id @default(uuid())
  number             String           @unique
  sequence           Int              @unique @default(autoincrement())
  customer_id        String
  stage              Stage            @default(booked)
  address            String
  phone              String
  pickup_date        String
  slot               String
  notes              String           @default("")
  total              Int
  created_at         DateTime         @default(now())
  updated_at         DateTime         @default(now())
  version            Int              @default(0)
  assigned_to        String?
  expected_count     Int
  collected_count    Int?
  delivery_code_hash String?
  delivered_at       DateTime?
  customer           User             @relation("CustomerOrders", fields: [customer_id], references: [id])
  assigned           User?            @relation("AssignedOrders", fields: [assigned_to], references: [id])
  items              OrderItem[]
  garments           Garment[]
  events             Event[]
  actions            Action[]
  issues             Issue[]
  booking_requests   BookingRequest[]

  @@index([customer_id, created_at])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  service_id String
  name       String
  unit       String
  price      Int
  quantity   Int
  sequence   Int     @unique @default(autoincrement())
  order      Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  service    Service @relation(fields: [service_id], references: [id])

  @@map("order_items")
}

model Garment {
  id         String   @id @default(uuid())
  order_id   String
  type       String
  color      String
  note       String   @default("")
  packed     Boolean  @default(false)
  delivered  Boolean  @default(false)
  created_at DateTime @default(now())
  sequence   Int      @unique @default(autoincrement())
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  issues     Issue[]

  @@index([order_id])
  @@map("garments")
}

model Event {
  id          String   @id @default(uuid())
  order_id    String
  actor_id    String
  kind        String
  description String
  created_at  DateTime @default(now())
  sequence    Int      @unique @default(autoincrement())
  order       Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actor_id], references: [id])

  @@index([order_id, created_at])
  @@map("events")
}

model Action {
  event_id     String @id
  actor_id     String
  order_id     String
  kind         String
  request_hash String
  response     String
  actor        User   @relation(fields: [actor_id], references: [id])
  order        Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("actions")
}

model Issue {
  id          String      @id @default(uuid())
  order_id    String
  customer_id String
  garment_id  String?
  category    String
  message     String
  status      IssueStatus @default(open)
  resolution  String?
  created_at  DateTime    @default(now())
  resolved_at DateTime?
  order       Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  customer    User        @relation(fields: [customer_id], references: [id])
  garment     Garment?    @relation(fields: [garment_id], references: [id])

  @@map("issues")
}

model BookingRequest {
  request_id   String @id
  customer_id  String
  order_id     String
  request_hash String
  response     String
  customer     User   @relation(fields: [customer_id], references: [id])
  order        Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("booking_requests")
}
