generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  staff
  owner
}

enum Stage {
  booked
  collected
  received
  cleaning
  quality_check
  packing
  ready
  out_for_delivery
  delivered
  cancelled
}

enum IssueStatus {
  open
  resolved
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum StaffRequestStatus {
  pending
  approved
  declined
}

model User {
  id                   String              @id @default(uuid())
  name                 String
  email                String              @unique
  phone                String
  role                 Role                @default(customer)
  password_hash        String
  email_verified_at    DateTime?
  google_sub           String?             @unique
  active               Boolean             @default(true)
  version              Int                 @default(0)
  staff_requested_at   DateTime?
  staff_request_status StaffRequestStatus?
  created_at           DateTime            @default(now())
  push_enabled         Boolean             @default(true)
  notifications        Notification[]
  push_devices         PushDevice[]
  email_verification   EmailVerification?
  sessions             Session[]
  orders               Order[]             @relation("CustomerOrders")
  assignments          Order[]             @relation("AssignedOrders")
  events               Event[]
  actions              Action[]
  issues               Issue[]
  booking_requests     BookingRequest[]
  tickets              Ticket[]            @relation("RequestedTickets")
  assigned_tickets     Ticket[]            @relation("AssignedTickets")
  ticket_messages      TicketMessage[]
  account_events       AccountEvent[]      @relation("AccountTarget")
  account_actions      AccountEvent[]      @relation("AccountActor")

  @@map("users")
}

model Notification {
  id          String         @id @default(uuid())
  user_id     String
  event_key   String
  category    String
  title       String
  body        String
  target_type String
  target_id   String?
  created_at  DateTime       @default(now())
  read_at     DateTime?
  user        User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries  PushDelivery[]

  @@unique([user_id, event_key])
  @@index([user_id, created_at, id])
  @@index([user_id, read_at])
  @@map("notifications")
}

model PushDevice {
  id          String         @id
  user_id     String
  expo_token  String         @unique
  platform    String
  enabled     Boolean        @default(true)
  updated_at  DateTime       @default(now())
  user        User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries  PushDelivery[]

  @@index([user_id])
  @@map("push_devices")
}

model PushDelivery {
  id              String       @id @default(uuid())
  notification_id String
  device_id       String
  state           String       @default("pending")
  attempts        Int          @default(0)
  next_attempt    DateTime     @default(now())
  ticket_id       String?
  last_error      String?
  created_at      DateTime     @default(now())
  notification    Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  device          PushDevice   @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, device_id])
  @@index([state, next_attempt])
  @@map("push_deliveries")
}

model EmailVerification {
  id           String   @id @default(uuid())
  user_id      String   @unique
  code_hash    String
  expires_at   DateTime
  resend_after DateTime
  attempts     Int      @default(0)
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model Session {
  token_hash String   @id
  user_id    String
  expires_at DateTime
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("sessions")
}

model Service {
  id          String      @id
  name        String
  description String
  unit        String
  price       Int
  hours       Int
  active      Boolean     @default(true)
  items       OrderItem[]

  @@map("services")
}

model Order {
  id                 String           @id @default(uuid())
  number             String           @unique
  sequence           Int              @unique @default(autoincrement())
  customer_id        String
  stage              Stage            @default(booked)
  address            String
  phone              String
  pickup_date        String
  slot               String
  notes              String           @default("")
  total              Int
  created_at         DateTime         @default(now())
  updated_at         DateTime         @default(now())
  version            Int              @default(0)
  assigned_to        String?
  expected_count     Int
  collected_count    Int?
  delivery_code_hash String?
  delivered_at       DateTime?
  customer           User             @relation("CustomerOrders", fields: [customer_id], references: [id])
  assigned           User?            @relation("AssignedOrders", fields: [assigned_to], references: [id])
  items              OrderItem[]
  garments           Garment[]
  events             Event[]
  actions            Action[]
  issues             Issue[]
  booking_requests   BookingRequest[]
  tickets            Ticket[]

  @@index([customer_id, created_at])
  @@map("orders")
}

model Ticket {
  id             String          @id @default(uuid())
  subject        String
  category       String
  requester_id   String
  requester_role Role            @default(customer)
  assigned_to    String?
  order_id       String?
  status         TicketStatus    @default(open)
  version        Int             @default(0)
  request_hash   String
  created_at     DateTime        @default(now())
  updated_at     DateTime        @default(now())
  requester      User            @relation("RequestedTickets", fields: [requester_id], references: [id])
  assigned       User?           @relation("AssignedTickets", fields: [assigned_to], references: [id])
  order          Order?          @relation(fields: [order_id], references: [id])
  messages       TicketMessage[]

  @@index([requester_id, updated_at])
  @@index([assigned_to, status])
  @@map("tickets")
}

model TicketMessage {
  id           String   @id @default(uuid())
  ticket_id    String
  author_id    String
  author_role  Role
  kind         String   @default("reply")
  request_hash String   @default("")
  body         String
  created_at   DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [author_id], references: [id])

  @@index([ticket_id, created_at])
  @@map("ticket_messages")
}

model AccountEvent {
  id         String   @id @default(uuid())
  target_id  String
  actor_id   String
  kind       String
  detail     String
  created_at DateTime @default(now())
  target     User     @relation("AccountTarget", fields: [target_id], references: [id])
  actor      User     @relation("AccountActor", fields: [actor_id], references: [id])

  @@index([created_at])
  @@map("account_events")
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  service_id String
  name       String
  unit       String
  price      Int
  quantity   Int
  sequence   Int     @unique @default(autoincrement())
  order      Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  service    Service @relation(fields: [service_id], references: [id])

  @@map("order_items")
}

model Garment {
  id         String   @id @default(uuid())
  order_id   String
  type       String
  color      String
  note       String   @default("")
  packed     Boolean  @default(false)
  delivered  Boolean  @default(false)
  created_at DateTime @default(now())
  sequence   Int      @unique @default(autoincrement())
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  issues     Issue[]

  @@index([order_id])
  @@map("garments")
}

model Event {
  id          String   @id @default(uuid())
  order_id    String
  actor_id    String
  kind        String
  description String
  created_at  DateTime @default(now())
  sequence    Int      @unique @default(autoincrement())
  order       Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actor_id], references: [id])

  @@index([order_id, created_at])
  @@map("events")
}

model Action {
  event_id     String @id
  actor_id     String
  order_id     String
  kind         String
  request_hash String
  response     String
  actor        User   @relation(fields: [actor_id], references: [id])
  order        Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("actions")
}

model Issue {
  id          String      @id @default(uuid())
  order_id    String
  customer_id String
  garment_id  String?
  category    String
  message     String
  status      IssueStatus @default(open)
  resolution  String?
  created_at  DateTime    @default(now())
  resolved_at DateTime?
  order       Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  customer    User        @relation(fields: [customer_id], references: [id])
  garment     Garment?    @relation(fields: [garment_id], references: [id])

  @@map("issues")
}

model BookingRequest {
  request_id   String @id
  customer_id  String
  order_id     String
  request_hash String
  response     String
  customer     User   @relation(fields: [customer_id], references: [id])
  order        Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("booking_requests")
}
