PORT=4000
# Direct TCP connection string from Prisma Console. Keep it only in the backend.
DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# Native clients do not require a browser origin.
WEB_ORIGINS=
# Use 1 on Render; keep 0 for direct local connections.
TRUST_PROXY_HOPS=0
# Required to deliver verification codes. Use a verified sender domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# OAuth Web client ID from Google Cloud, also used by the mobile app.
GOOGLE_WEB_CLIENT_ID=
# Optional Expo access token when enhanced push security is enabled in Expo.
EXPO_ACCESS_TOKEN=
